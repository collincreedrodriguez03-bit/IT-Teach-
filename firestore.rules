rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data, uid) {
      return data.userId == uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        data.xp is int && data.xp >= 0 &&
        data.level is int && data.level >= 1 &&
        data.streakCount is int && data.streakCount >= 0 &&
        (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 20)) &&
        (!('badges' in data) || (data.badges is list && data.badges.size() <= 50)) &&
        (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() <= 128)) &&
        (!('failedPinAttempts' in data) || (data.failedPinAttempts is int && data.failedPinAttempts >= 0)) &&
        (!('lockoutUntil' in data) || data.lockoutUntil is int);
    }

    function isValidDictionaryTerm(data, uid) {
      return data.userId == uid &&
        data.term is string && data.term.size() > 0 && data.term.size() <= 150 &&
        (!('command' in data) || (data.command is string && data.command.size() <= 1000)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
        data.difficulty is string && data.difficulty.size() > 0 && data.difficulty.size() <= 30 &&
        data.isMastered is bool &&
        data.isAiGenerated is bool &&
        (!('aiExplanation' in data) || (data.aiExplanation is string && data.aiExplanation.size() <= 3000));
    }

    function isValidJournalEntry(data, uid) {
      return data.userId == uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.notes is string && data.notes.size() <= 10000 &&
        (!('solution' in data) || (data.solution is string && data.solution.size() <= 10000)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 30)) &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
        data.isVerified is bool &&
        (!('isMastered' in data) || data.isMastered is bool);
    }

    function isValidPortfolioProject(data, uid) {
      return data.userId == uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.executiveSummary is string && data.executiveSummary.size() <= 5000 &&
        data.problemBusinessNeed is string && data.problemBusinessNeed.size() <= 5000 &&
        (!('toolsTechnologies' in data) || (data.toolsTechnologies is list && data.toolsTechnologies.size() <= 30)) &&
        data.architectureSteps is string && data.architectureSteps.size() <= 15000 &&
        (!('resultsMetrics' in data) || (data.resultsMetrics is string && data.resultsMetrics.size() <= 5000)) &&
        (!('verifiedEvidence' in data) || (data.verifiedEvidence is string && data.verifiedEvidence.size() <= 10000)) &&
        (!('lessonsLearned' in data) || (data.lessonsLearned is string && data.lessonsLearned.size() <= 5000)) &&
        data.isVerified is bool &&
        (!('isMastered' in data) || data.isMastered is bool) &&
        (!('linkedJournalIds' in data) || (data.linkedJournalIds is list && data.linkedJournalIds.size() <= 50));
    }

    function isValidQuest(data, uid) {
      return data.userId == uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        data.questType is string && data.questType.size() > 0 && data.questType.size() <= 30 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
        data.xpReward is int && data.xpReward >= 0 &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 30 &&
        (!('outsideLearningRequirement' in data) || (data.outsideLearningRequirement is string && data.outsideLearningRequirement.size() <= 3000)) &&
        (!('isVerified' in data) || data.isVerified is bool) &&
        (!('isMastered' in data) || data.isMastered is bool);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().createdAt is timestamp &&
                       isValidTimestamp(incoming().createdAt) &&
                       (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

      allow update: if isOwner(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

      allow delete: if isOwner(userId);

      match /dictionary/{termId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(termId) &&
                         isValidDictionaryTerm(incoming(), userId) &&
                         incoming().createdAt is timestamp &&
                         isValidTimestamp(incoming().createdAt) &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow update: if isOwner(userId) &&
                         isValidDictionaryTerm(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow delete: if isOwner(userId);
      }

      match /journal/{entryId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming(), userId) &&
                         incoming().createdAt is timestamp &&
                         isValidTimestamp(incoming().createdAt) &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow update: if isOwner(userId) &&
                         isValidJournalEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow delete: if isOwner(userId);
      }

      match /projects/{projectId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         isValidPortfolioProject(incoming(), userId) &&
                         incoming().createdAt is timestamp &&
                         isValidTimestamp(incoming().createdAt) &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow update: if isOwner(userId) &&
                         isValidPortfolioProject(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow delete: if isOwner(userId);
      }

      match /quests/{questId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(questId) &&
                         isValidQuest(incoming(), userId) &&
                         incoming().createdAt is timestamp &&
                         isValidTimestamp(incoming().createdAt) &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow update: if isOwner(userId) &&
                         isValidQuest(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

        allow delete: if isOwner(userId);
      }
    }
  }
}
